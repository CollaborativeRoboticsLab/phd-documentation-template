# Ignore common LaTeX build files

# Main output file
*.pdf

# Auxiliary files generated by pdflatex
*.aux
*.log
# Table of Contents
*.toc
# List of Figures
*.lof
# List of Tables
*.lot
# Navigation file (for presentations)
*.nav
# Snapshot file (for presentations)
*.snm
# Output file (sometimes used by packages)
*.output
*.out
# File list
*.fls
# latexmk file database
*.fdb_latexmk

# Bibliography files generated by bibtex/biber
# Generated bibliography file
*.bbl
*.bcf
# BibTeX/Biber log file
*.blg
*.run.xml

# SyncTeX file for syncing between source and PDF
*.synctex.gz
*.synctex

# Editor specific files (VS Code specific examples if any, though less common for standard LaTeX)
# .vscode/

# If you have specific build directories, you might ignore them too, e.g.:
build/
